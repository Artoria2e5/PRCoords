cabal-version:       3.0
name:                prcoords
version:             1.1.0

synopsis:            GCJ-02 and BD-09 coordinate obfuscation from and to WGS-84.

description:         People's Rectified Coordinates (PRCoords) is a cross-language
                     implementation of "public secret" Chinese coordinate obfuscation
                     methods including GCJ-02 and BD-09, along with general
                     deobfuscation methods previously established in pycoordtrans,
                     eviltransform, and geoChina.

homepage:            https://github.com/Artoria2e5/PRCoords
license:             CC0-1.0
author:              Mingye Wang
maintainer:          arthur200126@gmail.com
category:            Geography
build-type:          Simple
tested-with:         GHC == 9.6.7 || == 9.14.1
extra-doc-files:     CHANGELOG.md

source-repository head
  type:                git
  location:            https://github.com/Artoria2e5/PRCoords

common fastmath
  ghc-options:         -optlc--enable-unsafe-fp-math
                       -optlc--enable-no-nans-fp-math
                       -optlc--enable-no-infs-fp-math
                       -optlc--enable-no-signed-zeros-fp-math
                       -optlc--enable-no-trapping-fp-math

flag llvm
  description:         Compile with the LLVM backend
  default:             False
  manual:              True

library
  import:              fastmath
  if flag(llvm)
    ghc-options:       -fllvm
  exposed-modules:     PRCoords
  other-extensions:    Strict
  build-depends:       base >=4.9 && <5
  default-language:    Haskell2010

executable vecs
  import:              fastmath
  if flag(llvm)
    ghc-options:       -fllvm
  main-is:             Vecs.hs
  other-modules:       PRCoords
  ghc-options:         -rtsopts=all
  hs-source-dirs:      .
  build-depends:       base >=4.9 && <5,
                       prcoords
  default-language:    Haskell2010
